{
  "$schema": "https://design-tokens.org/1.0.json",
  "$description": "Rumbo Design System · fuente de verdad de tokens. Editar aquí y correr `node scripts/build-tokens.mjs`. Ver docs/decisions/2026-08-13-valores-canonicos.md",

  "color": {
    "brand": {
      "blue":     { "$value": "#382EDC", "$type": "color", "$description": "Rumbo blue · señal principal" },
      "blue-700": { "$value": "#2A22A8", "$type": "color" },
      "blue-300": { "$value": "#8078F0", "$type": "color" },
      "cyan":     { "$value": "#47EBEB", "$type": "color", "$description": "Beacon cyan · highlight" },
      "cyan-600": { "$value": "#19B8B8", "$type": "color" },
      "purple":   { "$value": "#8452FD", "$type": "color", "$description": "Journey purple · depth (RGB 132·82·253)" },
      "ink":      { "$value": "#0A0A0B", "$type": "color", "$description": "Anchor · canónico (acta #1)" },
      "paper":    { "$value": "#F4F2ED", "$type": "color", "$description": "Respiro cálido · canónico (acta #2)" },
      "white":    { "$value": "#FFFFFF", "$type": "color" }
    },
    "functional": {
      "orange":  { "$value": "#FF5A36", "$type": "color", "$description": "Solo estados de error — NO es color de marca (acta #4)" },
      "success": { "$value": "#3CCB7F", "$type": "color" },
      "warning": { "$value": "#FFB020", "$type": "color" },
      "danger":  { "$value": "{color.functional.orange}", "$type": "color" }
    },
    "theme": {
      "dark": {
        "bg":            { "$value": "{color.brand.ink}", "$type": "color" },
        "bg-elev":       { "$value": "#121214", "$type": "color" },
        "bg-subtle":     { "$value": "#17171A", "$type": "color" },
        "surface":       { "$value": "#1B1B1F", "$type": "color" },
        "surface-2":     { "$value": "#242428", "$type": "color" },
        "border":        { "$value": "rgba(255,255,255,.08)", "$type": "color" },
        "border-strong": { "$value": "rgba(255,255,255,.16)", "$type": "color" },
        "text":          { "$value": "#FAFAFA", "$type": "color" },
        "text-muted":    { "$value": "rgba(255,255,255,.64)", "$type": "color" },
        "text-dim":      { "$value": "rgba(255,255,255,.44)", "$type": "color" },
        "accent":        { "$value": "{color.brand.blue}", "$type": "color" },
        "accent-fg":     { "$value": "{color.brand.white}", "$type": "color" },
        "accent-soft":   { "$value": "rgba(56,46,220,.14)", "$type": "color" },
        "highlight":     { "$value": "{color.brand.cyan}", "$type": "color" }
      },
      "light": {
        "bg":            { "$value": "{color.brand.paper}", "$type": "color" },
        "bg-elev":       { "$value": "#FBFAF7", "$type": "color" },
        "bg-subtle":     { "$value": "#EFEDE7", "$type": "color" },
        "surface":       { "$value": "{color.brand.white}", "$type": "color" },
        "surface-2":     { "$value": "{color.brand.paper}", "$type": "color" },
        "border":        { "$value": "rgba(10,10,11,.08)", "$type": "color" },
        "border-strong": { "$value": "rgba(10,10,11,.18)", "$type": "color" },
        "text":          { "$value": "{color.brand.ink}", "$type": "color" },
        "text-muted":    { "$value": "rgba(10,10,11,.64)", "$type": "color" },
        "text-dim":      { "$value": "rgba(10,10,11,.44)", "$type": "color" },
        "accent-soft":   { "$value": "rgba(56,46,220,.10)", "$type": "color" }
      }
    }
  },

  "spacing": {
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "5":  { "$value": "20px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "20": { "$value": "80px", "$type": "dimension" },
    "24": { "$value": "96px", "$type": "dimension" }
  },

  "radius": {
    "0":    { "$value": "0px",    "$type": "dimension", "$description": "Campos técnicos, tags" },
    "1":    { "$value": "4px",    "$type": "dimension", "$description": "Botones sm, inputs técnicos" },
    "2":    { "$value": "8px",    "$type": "dimension", "$description": "Default — inputs, botones" },
    "3":    { "$value": "12px",   "$type": "dimension", "$description": "Cards, modales, stages" },
    "4":    { "$value": "16px",   "$type": "dimension", "$description": "Hero, secciones grandes" },
    "full": { "$value": "9999px", "$type": "dimension", "$description": "Pills, avatars" }
  },

  "shadow": {
    "dark": {
      "1":    { "$value": "0 1px 2px rgba(0,0,0,.4)", "$type": "shadow" },
      "2":    { "$value": "0 4px 12px rgba(0,0,0,.5)", "$type": "shadow" },
      "3":    { "$value": "0 12px 32px rgba(0,0,0,.55), 0 2px 6px rgba(0,0,0,.4)", "$type": "shadow" },
      "glow": { "$value": "0 0 0 1px rgba(56,46,220,.5), 0 8px 24px rgba(56,46,220,.35)", "$type": "shadow" }
    },
    "light": {
      "1": { "$value": "0 1px 2px rgba(10,10,11,.08)", "$type": "shadow" },
      "2": { "$value": "0 4px 12px rgba(10,10,11,.10)", "$type": "shadow" },
      "3": { "$value": "0 12px 32px rgba(10,10,11,.14), 0 2px 6px rgba(10,10,11,.06)", "$type": "shadow" }
    }
  },

  "typography": {
    "fontFamily": {
      "display": { "$value": "\"Dx Grafik\", \"Space Grotesk\", sans-serif", "$type": "fontFamily", "$description": "Black Italic: display/firma · SemiBold: titulares largos (acta #5)" },
      "sans":    { "$value": "\"Space Grotesk\", system-ui, sans-serif", "$type": "fontFamily" },
      "mono":    { "$value": "ui-monospace, \"SF Mono\", Menlo, monospace", "$type": "fontFamily" }
    },
    "scale-product": {
      "$description": "Escala de UI de producto (base 14) — acta #6",
      "xs":   { "$value": "11px", "$type": "dimension" },
      "sm":   { "$value": "12px", "$type": "dimension" },
      "base": { "$value": "14px", "$type": "dimension" },
      "md":   { "$value": "16px", "$type": "dimension" },
      "lg":   { "$value": "18px", "$type": "dimension" },
      "xl":   { "$value": "22px", "$type": "dimension" },
      "2xl":  { "$value": "28px", "$type": "dimension" },
      "3xl":  { "$value": "36px", "$type": "dimension" },
      "4xl":  { "$value": "48px", "$type": "dimension" },
      "5xl":  { "$value": "64px", "$type": "dimension" },
      "6xl":  { "$value": "88px", "$type": "dimension" }
    },
    "scale-marketing": {
      "$description": "Escala editorial del manual (cap. 06) — acta #6",
      "display": { "$value": { "fontSize": "96px", "lineHeight": "88px" }, "$type": "typography" },
      "h1":      { "$value": { "fontSize": "56px", "lineHeight": "56px" }, "$type": "typography" },
      "h2":      { "$value": { "fontSize": "36px", "lineHeight": "40px" }, "$type": "typography" },
      "body-l":  { "$value": { "fontSize": "20px", "lineHeight": "30px" }, "$type": "typography" },
      "body":    { "$value": { "fontSize": "16px", "lineHeight": "24px" }, "$type": "typography" },
      "caption": { "$value": { "fontSize": "11px", "lineHeight": "16px" }, "$type": "typography" }
    }
  },

  "motion": {
    "duration": {
      "1": { "$value": "120ms", "$type": "duration", "$description": "Micro — hover, focus" },
      "2": { "$value": "200ms", "$type": "duration", "$description": "Default — fades, color" },
      "3": { "$value": "320ms", "$type": "duration", "$description": "Transforms, entradas" },
      "4": { "$value": "500ms", "$type": "duration", "$description": "Modales, page change" }
    },
    "easing": {
      "out":    { "$value": "cubic-bezier(.2,.7,.2,1)", "$type": "cubicBezier", "$description": "Default easing" },
      "spring": { "$value": "cubic-bezier(.18,.89,.32,1.28)", "$type": "cubicBezier", "$description": "Entradas juguetonas" }
    }
  },

  "brand-rules": {
    "$description": "Restricciones de marca (RNF-05) — informativas, no generan CSS",
    "color-ratio": { "$value": "ink 60 · blue 20 · paper 10 · cyan 7 · purple 3", "$type": "string" },
    "accent-rule": { "$value": "Un solo acento (cyan o purple) por pieza", "$type": "string" },
    "logo-clearspace": { "$value": "1x (altura del tallo base de la r)", "$type": "string" },
    "logo-forbidden": { "$value": "estirar · rotar · fondo purple", "$type": "string" }
  }
}
